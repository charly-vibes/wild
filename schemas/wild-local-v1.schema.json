{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://wild.local/schemas/wild-local-v1.schema.json",
 "title": "Wild local-1 protocol records",
 "description": "Separately versioned local protocol for bounded local contract checking (beads wild-mh5.1). Each record carries version and kind; unknown versions, kinds, and fields, duplicate object keys, floating-point numbers, out-of-range integers, and references escaping the supplied bundle are refused per the reader's v1 canonical rules. Local records hash with the v1 canonical JSON rules; this is not a v1 wire-kind extension.",
 "type": "object",
 "oneOf": [
  {
   "$ref": "#/$defs/extraction_request"
  },
  {
   "$ref": "#/$defs/extraction_report"
  },
  {
   "$ref": "#/$defs/demand"
  },
  {
   "$ref": "#/$defs/provenance"
  },
  {
   "$ref": "#/$defs/update_request"
  },
  {
   "$ref": "#/$defs/update_plan"
  },
  {
   "$ref": "#/$defs/update_authority"
  },
  {
   "$ref": "#/$defs/update_authority_pin"
  },
  {
   "$ref": "#/$defs/update_report"
  }
 ],
 "$defs": {
  "id": {
   "type": "string",
   "pattern": "^[A-Za-z_][A-Za-z0-9_.:/-]*$",
   "maxLength": 256
  },
  "digest": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$"
  },
  "profile_id": {
   "type": "string",
   "const": "rust-cargo-local-1"
  },
  "file_map": {
   "type": "object",
   "description": "Normalized bundle-relative path to committed raw sha256 digest. Every reference must resolve inside the supplied bundle; dot, dot-dot, and absolute components are refused.",
   "propertyNames": {
    "type": "string",
    "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$",
    "not": {
     "pattern": "(^|/)\\.\\.?(/|$)"
    }
   },
   "additionalProperties": {
    "$ref": "#/$defs/digest"
   }
  },
  "extractor_identity": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_-]+$"
    },
    "digest": {
     "$ref": "#/$defs/digest"
    }
   },
   "required": [
    "name",
    "digest"
   ],
   "additionalProperties": false
  },
  "diagnostic": {
   "type": "object",
   "properties": {
    "code": {
     "type": "string",
     "enum": [
      "incomplete-demand",
      "unsupported-construct",
      "input-mismatch",
      "obligation-change",
      "law-inconclusive",
      "ambiguous-package",
      "inherited-range",
      "unsupported-lock",
      "unsupported-manifest",
      "unknown-package",
      "base-changed",
      "plan-ready"
     ]
    },
    "severity": {
     "type": "string",
     "enum": [
      "error",
      "warning",
      "info"
     ]
    },
    "source": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "slots": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/id"
     },
     "uniqueItems": true
    },
    "reason": {
     "type": "string"
    }
   },
   "required": [
    "code",
    "severity",
    "source",
    "slots",
    "reason"
   ],
   "additionalProperties": false
  },
  "location": {
   "type": "object",
   "properties": {
    "slot": {
     "$ref": "#/$defs/id"
    },
    "file": {
     "type": "string"
    },
    "line": {
     "type": "integer",
     "minimum": 1
    },
    "col": {
     "type": "integer",
     "minimum": 0
    }
   },
   "required": [
    "slot",
    "file",
    "line",
    "col"
   ],
   "additionalProperties": false
  },
  "update_request": {
   "type": "object",
   "description": "Read-only update planning request (beads wild-nic.1): names the bundle, the manifest to edit, the exact package target/release with source artifact digest, and environment/policy commitments. No candidate or baseline code is executed during planning.",
   "properties": {
    "version": {
     "const": "local-1"
    },
    "kind": {
     "const": "update-request"
    },
    "bundle_root": {
     "type": "string"
    },
    "files": {
     "$ref": "#/$defs/file_map"
    },
    "manifest": {
     "type": "string",
     "description": "Bundle-relative path to the Cargo.toml that declares the target dependency"
    },
    "package": {
     "$ref": "#/$defs/id"
    },
    "release": {
     "type": "string",
     "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$"
    },
    "source_digest": {
     "$ref": "#/$defs/digest"
    },
    "target": {
     "type": "string"
    },
    "toolchain": {
     "type": "string"
    },
    "features": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "consumer": {
     "$ref": "#/$defs/id"
    },
    "policy": {
     "type": "object"
    },
    "catalog": {
     "type": "object",
     "properties": {
      "kind": {
       "type": "string"
      },
      "digest": {
       "$ref": "#/$defs/digest"
      }
     },
     "required": [
      "kind",
      "digest"
     ],
     "additionalProperties": false
    },
    "migration_digest": {
     "anyOf": [
      {
       "$ref": "#/$defs/digest"
      },
      {
       "type": "null"
      }
     ]
    },
    "planner": {
     "$ref": "#/$defs/extractor_identity"
    }
   },
   "required": [
    "version",
    "kind",
    "bundle_root",
    "files",
    "manifest",
    "package",
    "release",
    "source_digest",
    "target",
    "toolchain",
    "features",
    "consumer",
    "policy",
    "catalog",
    "planner"
   ],
   "additionalProperties": false
  },
  "update_plan": {
   "type": "object",
   "description": "Immutable committed update plan (beads wild-nic.1). Planning success is a well-formed eligible proposal, NOT an accepted compatibility check: assurance stays Unknown and every required validation is listed as pending.",
   "properties": {
    "version": {
     "const": "local-1"
    },
    "kind": {
     "const": "update-plan"
    },
    "consumer": {
     "anyOf": [
      {
       "$ref": "#/$defs/id"
      },
      {
       "type": "null"
      }
     ]
    },
    "package": {
     "$ref": "#/$defs/id"
    },
    "release": {
     "type": "string"
    },
    "request_digest": {
     "$ref": "#/$defs/digest"
    },
    "original_range": {
     "type": "string"
    },
    "edit": {
     "type": "object",
     "properties": {
      "file": {
       "type": "string"
      },
      "table": {
       "type": "string"
      },
      "package": {
       "$ref": "#/$defs/id"
      },
      "from": {
       "type": "string"
      },
      "to": {
       "type": "string"
      }
     },
     "required": [
      "file",
      "table",
      "package",
      "from",
      "to"
     ],
     "additionalProperties": false
    },
    "why": {
     "type": "string"
    },
    "excluded_by_original_range": {
     "type": "boolean"
    },
    "source_digest": {
     "anyOf": [
      {
       "$ref": "#/$defs/digest"
      },
      {
       "type": "null"
      }
     ]
    },
    "lock_version": {
     "type": "string"
    },
    "preconditions": {
     "$ref": "#/$defs/file_map",
     "description": "Base-file digests that must still match at evaluation time before any edit is applied"
    },
    "allowed_changed_paths": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "contracts": {
     "type": [
      "object",
      "null"
     ],
     "description": "Optional caller-committed contract digests per dependency package name; entries absent from this map have no usable contract",
     "additionalProperties": {
      "$ref": "#/$defs/digest"
     }
    },
    "pending_checks": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "uniqueItems": true
    },
    "assurance": {
     "const": "Unknown"
    },
    "disposition": {
     "const": "plan-ready"
    },
    "diagnostics": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/diagnostic"
     }
    }
   },
   "required": [
    "version",
    "kind",
    "consumer",
    "package",
    "release",
    "request_digest",
    "original_range",
    "edit",
    "why",
    "excluded_by_original_range",
    "source_digest",
    "lock_version",
    "preconditions",
    "allowed_changed_paths",
    "pending_checks",
    "assurance",
    "disposition",
    "diagnostics"
   ],
   "additionalProperties": false
  },
  "extraction_request": {
   "type": "object",
   "properties": {
    "version": {
     "const": "local-1"
    },
    "kind": {
     "const": "extraction-request"
    },
    "profile": {
     "$ref": "#/$defs/profile_id"
    },
    "bundle_root": {
     "type": "string"
    },
    "files": {
     "$ref": "#/$defs/file_map"
    },
    "target": {
     "type": "string"
    },
    "toolchain": {
     "type": "string"
    },
    "features": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "extractor": {
     "$ref": "#/$defs/extractor_identity"
    }
   },
   "required": [
    "version",
    "kind",
    "profile",
    "bundle_root",
    "files",
    "target",
    "toolchain",
    "features",
    "extractor"
   ],
   "additionalProperties": false
  },
  "extraction_report": {
   "type": "object",
   "properties": {
    "version": {
     "const": "local-1"
    },
    "kind": {
     "const": "extraction-report"
    },
    "profile": {
     "$ref": "#/$defs/profile_id"
    },
    "complete_inventory": {
     "type": "boolean"
    },
    "diagnostics": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/diagnostic"
     }
    }
   },
   "required": [
    "version",
    "kind",
    "profile",
    "complete_inventory",
    "diagnostics"
   ],
   "additionalProperties": false
  },
  "demand_entry": {
   "type": "object",
   "properties": {
    "consumer": {
     "$ref": "#/$defs/id"
    },
    "called": {
     "type": "string"
    },
    "alias": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "provider_slot": {
     "$ref": "#/$defs/id"
    }
   },
   "required": [
    "consumer",
    "called",
    "alias",
    "provider_slot"
   ],
   "additionalProperties": false
  },
  "demand": {
   "type": "object",
   "properties": {
    "version": {
     "const": "local-1"
    },
    "kind": {
     "const": "demand"
    },
    "entries": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/demand_entry"
     }
    }
   },
   "required": [
    "version",
    "kind",
    "entries"
   ],
   "additionalProperties": false
  },
  "provenance": {
   "type": "object",
   "properties": {
    "version": {
     "const": "local-1"
    },
    "kind": {
     "const": "provenance"
    },
    "bundle_root": {
     "type": "string"
    },
    "files": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "path": {
        "type": "string"
       },
       "raw_digest": {
        "$ref": "#/$defs/digest"
       }
      },
      "required": [
       "path",
       "raw_digest"
      ],
      "additionalProperties": false
     }
    },
    "locations": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/location"
     }
    }
   },
   "required": [
    "version",
    "kind",
    "bundle_root",
    "files",
    "locations"
   ],
   "additionalProperties": false
  },
  "obligations_document": {
   "type": "object",
   "properties": {
    "version": {
     "const": "local-1"
    },
    "kind": {
     "const": "obligations"
    },
    "obligations": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/obligation_record"
     }
    }
   },
   "required": [
    "version",
    "kind",
    "obligations"
   ],
   "additionalProperties": false
  },
  "obligation_record": {
   "type": "object",
   "properties": {
    "id": {
     "$ref": "#/$defs/id"
    },
    "scope": {
     "$ref": "#/$defs/id"
    },
    "origin": {
     "type": "string",
     "enum": [
      "human",
      "agent"
     ]
    },
    "state": {
     "type": "string",
     "enum": [
      "accepted",
      "proposed"
     ]
    },
    "authority": {
     "type": "object",
     "properties": {
      "name": {
       "type": "string"
      },
      "digest": {
       "$ref": "#/$defs/digest"
      }
     },
     "required": [
      "name",
      "digest"
     ],
     "additionalProperties": false
    },
    "predicate": {
     "oneOf": [
      {
       "type": "object",
       "properties": {
        "kind": {
         "const": "structural"
        },
        "digest": {
         "$ref": "#/$defs/digest"
        },
        "contract": {
         "type": "object"
        }
       },
       "required": [
        "kind",
        "digest",
        "contract"
       ],
       "additionalProperties": false
      },
      {
       "type": "object",
       "properties": {
        "kind": {
         "const": "law"
        },
        "suite_digest": {
         "$ref": "#/$defs/digest"
        }
       },
       "required": [
        "kind",
        "suite_digest"
       ],
       "additionalProperties": false
      }
     ]
    }
   },
   "required": [
    "id",
    "scope",
    "origin",
    "state",
    "authority",
    "predicate"
   ],
   "additionalProperties": false
  },
  "transition_record": {
   "type": "object",
   "properties": {
    "old_digest": {
     "$ref": "#/$defs/digest"
    },
    "new_digest": {
     "$ref": "#/$defs/digest"
    },
    "reason": {
     "type": "string"
    },
    "affected_consumers": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/id"
     }
    },
    "authority": {
     "type": "object",
     "properties": {
      "name": {
       "type": "string"
      },
      "digest": {
       "$ref": "#/$defs/digest"
      }
     },
     "required": [
      "name",
      "digest"
     ],
     "additionalProperties": false
    }
   },
   "required": [
    "old_digest",
    "new_digest",
    "reason",
    "affected_consumers",
    "authority"
   ],
   "additionalProperties": false
  },
  "law_method": {
   "type": "object",
   "description": "One attempted law's method-labelled evidence in the check-report's law_methods array; method/status are null when no validated execution evidence was obtained.",
   "properties": {
    "obligation_id": {
     "$ref": "#/$defs/id"
    },
    "suite_digest": {
     "$ref": "#/$defs/digest"
    },
    "method": {
     "anyOf": [
      {
       "type": "string",
       "enum": [
        "proof",
        "exhaustive",
        "sampled"
       ]
      },
      {
       "type": "null"
      }
     ]
    },
    "status": {
     "anyOf": [
      {
       "type": "string",
       "enum": [
        "pass",
        "counterexample",
        "inconclusive"
       ]
      },
      {
       "type": "null"
      }
     ]
    },
    "witness": {
     "anyOf": [
      {
       "$ref": "#/$defs/digest"
      },
      {
       "type": "null"
      }
     ]
    },
    "reason": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "result_digest": {
     "anyOf": [
      {
       "$ref": "#/$defs/digest"
      },
      {
       "type": "null"
      }
     ]
    },
    "contract": {
     "anyOf": [
      {
       "$ref": "#/$defs/digest"
      },
      {
       "type": "null"
      }
     ]
    },
    "implementation_artifact": {
     "anyOf": [
      {
       "$ref": "#/$defs/digest"
      },
      {
       "type": "null"
      }
     ]
    },
    "harness": {
     "anyOf": [
      {
       "$ref": "#/$defs/digest"
      },
      {
       "type": "null"
      }
     ]
    },
    "runs": {
     "type": "integer",
     "minimum": 0
    }
   },
   "required": [
    "obligation_id",
    "suite_digest",
    "method",
    "status",
    "witness",
    "reason",
    "result_digest",
    "contract",
    "implementation_artifact",
    "harness",
    "runs"
   ],
   "additionalProperties": false
  },
  "sandbox_caps": {
   "type": "object",
   "description": "Enforced law-sandbox capabilities recorded in the invocation commitment; null when no law execution was attempted.",
   "properties": {
    "enforced": {
     "type": "boolean"
    },
    "landlock_abi": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 1
      },
      {
       "type": "null"
      }
     ]
    },
    "network": {
     "const": "denied"
    },
    "writes": {
     "const": "denied"
    },
    "reads": {
     "type": "string"
    },
    "rlimits": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "wall_ms": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 1
      },
      {
       "type": "null"
      }
     ]
    },
    "environment": {
     "const": "fixed"
    }
   },
   "required": [
    "enforced",
    "landlock_abi",
    "network",
    "writes",
    "reads",
    "rlimits",
    "wall_ms",
    "environment"
   ],
   "additionalProperties": false
  },
  "budgets": {
   "type": "object",
   "properties": {
    "wall_ms": {
     "type": "integer",
     "minimum": 1,
     "maximum": 3600000
    }
   },
   "required": [
    "wall_ms"
   ],
   "additionalProperties": false
  },
  "environment": {
   "type": "object",
   "properties": {
    "seed": {
     "type": "integer",
     "minimum": 0
    }
   },
   "required": [
    "seed"
   ],
   "additionalProperties": false
  },
  "evaluation_time": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
  },
  "invocation_commitment": {
   "type": "object",
   "properties": {
    "enforcement": {
     "type": "string",
     "enum": [
      "local"
     ]
    },
    "obligations_digest": {
     "anyOf": [
      {
       "$ref": "#/$defs/digest"
      },
      {
       "type": "null"
      }
     ]
    },
    "checker_digest": {
     "$ref": "#/$defs/digest"
    },
    "policy": {
     "type": "object"
    },
    "base_facts_digest": {
     "$ref": "#/$defs/digest"
    },
    "candidate_facts_digest": {
     "$ref": "#/$defs/digest"
    },
    "harnesses": {
     "anyOf": [
      {
       "$ref": "#/$defs/file_map"
      },
      {
       "type": "null"
      }
     ]
    },
    "fixtures": {
     "anyOf": [
      {
       "$ref": "#/$defs/file_map"
      },
      {
       "type": "null"
      }
     ]
    },
    "budgets": {
     "anyOf": [
      {
       "$ref": "#/$defs/budgets"
      },
      {
       "type": "null"
      }
     ]
    },
    "environment": {
     "anyOf": [
      {
       "$ref": "#/$defs/environment"
      },
      {
       "type": "null"
      }
     ]
    },
    "evaluation_time": {
     "anyOf": [
      {
       "$ref": "#/$defs/evaluation_time"
      },
      {
       "type": "null"
      }
     ]
    },
    "sandbox": {
     "anyOf": [
      {
       "$ref": "#/$defs/sandbox_caps"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "enforcement",
    "obligations_digest",
    "checker_digest",
    "policy",
    "base_facts_digest",
    "candidate_facts_digest",
    "harnesses",
    "fixtures",
    "budgets",
    "environment",
    "evaluation_time",
    "sandbox"
   ],
   "additionalProperties": false
  },
  "update_authority": {
   "type": "object",
   "description": "Trusted external invocation authority for one update plan (beads wild-nic.2). Supplied outside candidate control; the invocation pin commits its exact digest before anything runs.",
   "properties": {
    "version": {
     "const": "local-1"
    },
    "kind": {
     "const": "update-authority"
    },
    "plan_digest": {
     "$ref": "#/$defs/digest"
    },
    "bundle_root": {
     "type": "string"
    },
    "invocation": {
     "$ref": "#/$defs/invocation_identity"
    },
    "allowed_actions": {
     "type": "array",
     "items": {
      "type": "string",
      "enum": [
       "evaluate"
      ]
     }
    },
    "environment": {
     "$ref": "#/$defs/update_environment"
    },
    "policy": {
     "type": "object"
    }
   },
   "required": [
    "version",
    "kind",
    "plan_digest",
    "bundle_root",
    "invocation",
    "allowed_actions",
    "environment",
    "policy"
   ],
   "additionalProperties": false
  },
  "invocation_identity": {
   "type": "object",
   "description": "Named trusted invocation identity (CI job or local policy owner) pinned out of band.",
   "properties": {
    "name": {
     "type": "string"
    },
    "digest": {
     "$ref": "#/$defs/digest"
    }
   },
   "required": [
    "name",
    "digest"
   ],
   "additionalProperties": false
  },
  "update_environment": {
   "type": "object",
   "description": "Pinned validity context of the authorized evaluation: toolchain, target platform, features.",
   "properties": {
    "toolchain": {
     "type": "string"
    },
    "target": {
     "type": "string"
    },
    "features": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "required": [
    "toolchain",
    "target"
   ],
   "additionalProperties": false
  },
  "update_authority_pin": {
   "type": "object",
   "description": "External commitment by the trusted invocation that authorizes exactly one plan and one authority record; without this pin an authority file is not trusted.",
   "properties": {
    "version": {
     "const": "local-1"
    },
    "kind": {
     "const": "update-authority-pin"
    },
    "invocation": {
     "$ref": "#/$defs/invocation_identity"
    },
    "plan_digest": {
     "$ref": "#/$defs/digest"
    },
    "authority_digest": {
     "$ref": "#/$defs/digest"
    }
   },
   "required": [
    "version",
    "kind",
    "invocation",
    "plan_digest",
    "authority_digest"
   ],
   "additionalProperties": false
  },
  "update_report": {
   "type": "object",
   "description": "Evaluated host evidence for one authorized update plan (beads wild-nic.2). Records requested and actual identities; delivered-update status stays pending until the integrated checks land in U3.",
   "properties": {
    "version": {
     "const": "local-1"
    },
    "kind": {
     "const": "update-report"
    },
    "package": {
     "$ref": "#/$defs/id"
    },
    "release": {
     "type": "string"
    },
    "plan_digest": {
     "$ref": "#/$defs/digest"
    },
    "authority_digest": {
     "$ref": "#/$defs/digest"
    },
    "requested": {
     "type": "object",
     "properties": {
      "release": {
       "type": "string"
      },
      "source_digest": {
       "anyOf": [
        {
         "$ref": "#/$defs/digest"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "release",
      "source_digest"
     ],
     "additionalProperties": false
    },
    "actual": {
     "type": "object",
     "properties": {
      "version": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "source_digest": {
       "anyOf": [
        {
         "$ref": "#/$defs/digest"
        },
        {
         "type": "null"
        }
       ]
      },
      "lock_source": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "version",
      "source_digest",
      "lock_source"
     ],
     "additionalProperties": false
    },
    "lock_version": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "disposition": {
     "enum": [
      "host-evidence",
      "refused",
      "delivered",
      "error"
     ]
    },
    "assurance": {
     "const": "Unknown"
    },
    "pending_checks": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "scope": {
     "const": "local",
     "description": "A local report is scoped to the explicit host-selected assembly and is not a v1 registry certificate"
    },
    "resolution": {
     "const": "host-selected",
     "description": "Cargo selected under the authorized manifest; no registry newest-tip or lineage claim is made"
    },
    "update_class": {
     "enum": [
      "direct",
      "migration",
      "intent-change"
     ]
    },
    "closure": {
     "type": "array",
     "description": "Every lock entry with its coverage status and assurance; uncontracted entries remain visible as Unknown",
     "items": {
      "type": "object",
      "properties": {
       "package": {
        "type": "string"
       },
       "version": {
        "type": "string"
       },
       "status": {
        "enum": [
         "root",
         "target",
         "unchanged",
         "changed",
         "new"
        ]
       },
       "assurance": {
        "enum": [
         "Contract",
         "Unknown"
        ]
       }
      },
      "required": [
       "package",
       "version",
       "status",
       "assurance"
      ],
      "additionalProperties": false
     }
    },
    "evidence": {
     "type": "array",
     "description": "Actual executed commands with their roles and exit codes",
     "items": {
      "type": "object",
      "properties": {
       "role": {
        "type": "string"
       },
       "command": {
        "type": "string"
       },
       "exit_code": {
        "type": "integer"
       }
      },
      "required": [
       "role",
       "command",
       "exit_code"
      ],
      "additionalProperties": false
     }
    },
    "diff": {
     "type": "array",
     "description": "The pinned output diff: only manifest/lock files with before and after digests",
     "items": {
      "type": "object",
      "properties": {
       "path": {
        "type": "string"
       },
       "before_digest": {
        "$ref": "#/$defs/digest"
       },
       "after_digest": {
        "$ref": "#/$defs/digest"
       }
      },
      "required": [
       "path",
       "before_digest",
       "after_digest"
      ],
      "additionalProperties": false
     }
    },
    "diff_digest": {
     "anyOf": [
      {
       "$ref": "#/$defs/digest"
      },
      {
       "type": "null"
      }
     ]
    },
    "diagnostics": {
     "type": "array"
    }
   },
   "required": [
    "version",
    "kind",
    "package",
    "release",
    "plan_digest",
    "authority_digest",
    "requested",
    "actual",
    "lock_version",
    "disposition",
    "assurance",
    "pending_checks",
    "diagnostics"
   ],
   "additionalProperties": false
  }
 }
}
